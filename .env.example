# Telegram — обязательно для MVP (см. docs/ARCHITECTURE.md, раздел 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# GitHub — обязательно для push из скриптов/routine (scope: repo; для .github/workflows/ нужен ещё scope workflow)
GITHUB_TOKEN=

# YouTube (scripts/publish_youtube.py) — P0, ADR-006. Создать Google Cloud проект,
# включить YouTube Data API v3, OAuth client (Desktop app), скачать client_secret.json.
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_TOKEN_FILE=

# Google Drive (scripts/download_from_drive.py) — P0, ADR-002. Можно переиспользовать
# тот же Google Cloud проект, что и для YouTube, добавив scope drive.readonly.
GDRIVE_CLIENT_SECRETS_FILE=
GDRIVE_TOKEN_FILE=

# Facebook Reels (scripts/publish_facebook.py) — P0, ADR-006. Оформить бренд ROMAN
# как Facebook Page, создать Meta-приложение, получить Page Access Token.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Cloudflare Worker bridge (apps/telegram-bridge/) — P1, ADR-003. Секреты этого компонента
# задаются отдельно через `wrangler secret put` (не через этот .env) — см. apps/telegram-bridge/README.md.
